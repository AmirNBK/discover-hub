{
  "name": "discover-hub",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "node scripts/stack.mjs dev",
    "dev:frontend": "next dev",
    "build": "next build",
    "start": "node scripts/stack.mjs start",
    "start:frontend": "next start",
    "backend": "node scripts/stack.mjs manage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check:local": "playwright test --config playwright.local.config.ts",
    "check:deployment": "node scripts/check-deployment.mjs",
    "messages": "node scripts/stack.mjs manage show_messages",
    "format": "prettier --write pages components lib styles tests scripts *.ts *.js *.mjs *.json *.md",
    "images:prepare": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
