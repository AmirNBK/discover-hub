# Default local stack. npm run dev starts all three services.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=discoverhub
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100
# Used by Next.js when the frontend is started separately.
BACKEND_URL=http://127.0.0.1:8000
# The launcher generates a shared token. For separate hosts, set the same random
# token on Next.js and Django to authenticate connection-IP forwarding.
# BACKEND_PROXY_TOKEN=
# Cloud backend access requires this shared service token on every request.
# REQUIRE_BACKEND_PROXY_TOKEN=true
# Optional BACKEND project automation bypass, configured only on the frontend.
# BACKEND_PROTECTION_BYPASS_SECRET=
# For production, set DJANGO_DEBUG=false, a random secret, and secure cookies.
# DJANGO_SECRET_KEY=
# DJANGO_COOKIE_SECURE=true
# A new Foursquare Service API key, used only on the server for live nearby places.
FOURSQUARE_API_KEY=
